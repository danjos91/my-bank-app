<configuration>
    <springProperty scope="context" name="APP_ENVIRONMENT" source="MANAGEMENT_METRICS_TAGS_ENVIRONMENT" defaultValue="test"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS} %-5level [%thread] [%X{traceId},%X{spanId}] [env:${APP_ENVIRONMENT}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>

