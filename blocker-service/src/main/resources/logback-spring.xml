<configuration>
    <springProperty scope="context" name="LOGS_BOOTSTRAP_SERVERS" source="LOGS_BOOTSTRAP_SERVERS" defaultValue="kafka.kafka.svc.cluster.local:9092"/>
    <springProperty scope="context" name="LOGS_TOPIC" source="LOGS_TOPIC" defaultValue="service-logs"/>
    <springProperty scope="context" name="APP_ENVIRONMENT" source="MANAGEMENT_METRICS_TAGS_ENVIRONMENT" defaultValue="dev"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSS} %-5level [%thread] [%X{traceId},%X{spanId}] [env:${APP_ENVIRONMENT}] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="KAFKA" class="com.github.danielwegener.logback.kafka.KafkaAppender">
        <topic>${LOGS_TOPIC}</topic>
        <producerConfig>bootstrap.servers=${LOGS_BOOTSTRAP_SERVERS}</producerConfig>
        <encoder class="com.github.danielwegener.logback.kafka.encoding.LayoutKafkaMessageEncoder">
            <layout class="net.logstash.logback.layout.LogstashLayout">
                <customFields>{"environment":"${APP_ENVIRONMENT}"}</customFields>
            </layout>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="KAFKA"/>
    </root>
</configuration>

