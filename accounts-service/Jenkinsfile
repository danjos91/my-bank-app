pipeline {
    agent any

    environment {
        APP_NAME = 'accounts-service'
        DOCKER_REGISTRY = 'my-docker-registry' // Cambiar por tu registry real
        IMAGE_TAG = "${env.BUILD_NUMBER}"
        HELM_RELEASE_NAME = 'accounts-service'
    }

    stages {
        stage('Validation') {
            steps {
                echo 'Validating code style...'
                // sh 'mvn checkstyle:check' // Descomentar si hay checkstyle configurado
                sh 'mvn validate'
            }
        }

        stage('Build & Test') {
            steps {
                echo 'Building and Testing...'
                sh 'mvn clean package -DskipTests=false'
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    echo 'Building Docker Image...'
                    // En un entorno real con Docker Daemon:
                    // docker.build("${DOCKER_REGISTRY}/${APP_NAME}:${IMAGE_TAG}")
                    // Para Minikube local sin registry externo, a veces se usa:
                    // sh 'eval $(minikube docker-env) && docker build -t ${APP_NAME}:${IMAGE_TAG} .'
                    sh "docker build -t ${APP_NAME}:${IMAGE_TAG} ${APP_NAME}/"
                }
            }
        }

        /* 
        stage('Push Docker Image') {
            steps {
                script {
                    docker.withRegistry('', 'docker-hub-credentials-id') {
                        docker.image("${DOCKER_REGISTRY}/${APP_NAME}:${IMAGE_TAG}").push()
                        docker.image("${DOCKER_REGISTRY}/${APP_NAME}:${IMAGE_TAG}").push('latest')
                    }
                }
            }
        }
        */

        stage('Deploy to Test') {
            steps {
                echo 'Deploying to Test Environment...'
                script {
                    // Usamos Helm para desplegar en el namespace 'test'
                    sh """
                        helm upgrade --install ${HELM_RELEASE_NAME} ./helm/${APP_NAME} \
                        --namespace test --create-namespace \
                        --set image.repository=${APP_NAME} \
                        --set image.tag=${IMAGE_TAG} \
                        --set global.env=test
                    """
                }
            }
        }

        stage('Deploy to Prod') {
            input {
                message "Deploy to Production?"
                ok "Yes, deploy"
            }
            steps {
                echo 'Deploying to Production Environment...'
                script {
                    // Usamos Helm para desplegar en el namespace 'prod'
                    sh """
                        helm upgrade --install ${HELM_RELEASE_NAME} ./helm/${APP_NAME} \
                        --namespace prod --create-namespace \
                        --set image.repository=${APP_NAME} \
                        --set image.tag=${IMAGE_TAG} \
                        --set global.env=prod
                    """
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            echo 'Pipeline succeeded!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}

